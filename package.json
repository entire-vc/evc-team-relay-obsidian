{
  "name": "team-relay-sync",
  "version": "0.1.3",
  "description": "Enterprise collaboration with self-hosted relay infrastructure for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "release": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "beta": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs debug",
    "staging": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs staging",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "jest",
    "lint": "npx eslint src/",
    "lint:obsidian-api": "eslint src/ --parser-options '{\"project\":\"./tsconfig.json\"}' --rule 'obsidianmd/no-unsupported-api:error' --rule '@typescript-eslint/no-floating-promises:error' --rule 'obsidianmd/prefer-create-el:error'",
    "typecheck:svelte": "bash scripts/check-svelte-types.sh",
    "typecheck:tests": "bash scripts/check-tests-types.sh",
    "check:svelte-events": "bash scripts/check-svelte-events.sh"
  },
  "keywords": [
    "obsidian",
    "collaboration",
    "relay",
    "real-time",
    "enterprise"
  ],
  "author": "EVC Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entire-vc/evc-team-relay-obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/entire-vc/evc-team-relay-obsidian/issues"
  },
  "homepage": "https://github.com/entire-vc/evc-team-relay-obsidian#readme",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.30.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/diff-match-patch": "^1.0.36",
    "@types/eventsource": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/path-browserify": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "obsidian": "^1.13.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "ts-jest": "^29.4.12",
    "tslib": "2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "diff-match-patch": "^1.0.5",
    "eventsource": "^5.1.1",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.10",
    "lib0": "^0.2.117",
    "lucide-svelte": "^0.577.0",
    "monkey-around": "^3.0.0",
    "obsidian-daily-notes-interface": "^0.9.5",
    "path-browserify": "^1.0.1",
    "svelte-step-wizard": "^0.0.2",
    "tslib": "2.8.1",
    "uuid": "^14.0.2",
    "y-leveldb": "^0.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": "^3.15.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.2"
    },
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.2"
    },
    "obsidian": {
      "moment": "^2.31.0"
    },
    "fast-uri": "^3.1.7"
  }
}
